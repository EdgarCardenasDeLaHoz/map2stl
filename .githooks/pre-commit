#!/bin/sh
# Lint only the staged Python files. The whole tree still has pre-existing ruff
# findings that no single commit should have to fix; the full test suite runs in
# pre-push. Enabled by scripts/setup-venv.ps1 (git config core.hooksPath .githooks).
set -e
cd "$(git rev-parse --show-toplevel)"

RUFF="$HOME/.venvs/map2stl/Scripts/ruff.exe"
[ -f "$RUFF" ] || RUFF="ruff"

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$STAGED_PY" ] && exit 0

echo "Running lint on staged Python files..."
# --force-exclude: ruff.toml exclusions (notebooks/) apply to explicitly passed paths too.
"$RUFF" check --force-exclude $STAGED_PY
