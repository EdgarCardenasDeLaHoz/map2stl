#!/bin/sh
# Run the test suites before every push: Python (this repo's and ../numpy2stl's,
# per pytest.ini) in parallel, then the JS unit tests and eslint.
# Enabled by scripts/setup-venv.ps1 (core.hooksPath .githooks).
set -e
cd "$(git rev-parse --show-toplevel)"

PYTHON="$HOME/.venvs/map2stl/Scripts/python.exe"
if [ ! -f "$PYTHON" ]; then
    echo "pre-push: $PYTHON missing; run scripts/setup-venv.ps1" >&2
    exit 1
fi

echo "Running Python test suite before push..."
# -n 6 needs pytest-xdist (requirements-dev.txt).
"$PYTHON" -m pytest -q --tb=short -p no:cacheprovider -x -n 6 --durations=10

echo "Running JS tests..."
npx vitest run

# eslint also catches JS syntax errors (it replaced tests/js/syntaxCheck.test.js,
# which spawned one `node --check` per file).
echo "Running eslint..."
npx eslint app/client/static/js
